.env
.env.*
!.env.example

# ---------- Build output ----------
dist/
build/
out/
.next/
backend/test-build/
*.tsbuildinfo

# ---------- Crawlee / Playwright runtime state ----------
backend/storage/
.crawlee/
playwright-report/
test-results/

