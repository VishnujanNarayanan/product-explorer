*-debug.html
*-debug.png
page-screenshot.png
navigation-results.json
new-navigation-results.json

# ---------- Python tooling (scripts/) ----------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ---------- Personal résumé material ----------
# Generated by the bullet-extract skill from this repo's code. Career notes, not
# project files: keyword coverage, target job titles, and an explicit list of skill
# gaps. Public repo, so these stay local.
bullet_extract*.yaml
resume_extract*.yaml

