# Backend configuration.
# Copy to .env in this directory (the repo root) and adjust as needed:
#   cp .env.example .env
# The defaults below match the services defined in docker-compose.yml.

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password
DB_DATABASE=wob_explorer

# ---------- Redis (BullMQ queue + response cache) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Application ----------
# The frontend expects the API on 3001; Next.js occupies 3000.
PORT=3001
# "development" enables TypeORM synchronize + SQL logging. Leave unset in
# production so the schema stays owned by backend/database/schema.sql.
NODE_ENV=development
# Cached listing TTL, in seconds (24h).
CACHE_TTL=86400

# ---------- Scraping (ethical defaults) ----------
# Delay between sequential requests to World of Books, in milliseconds.
SCRAPE_DELAY_MS=3000
# Scrape the navigation tree once on startup when the table is empty. Set to false in CI, in
# tests, or in any deployment that populates the database with `npm run seed` instead. A
# failure here is logged and never blocks startup.
SCRAPE_ON_STARTUP=true

# Retries per request before a scrape is marked failed.
SCRAPE_RETRY_COUNT=3
# Send a complete, honest browser UA. A truncated one reads as a bot.
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ---------- CORS ----------
FRONTEND_URL=http://localhost:3000
