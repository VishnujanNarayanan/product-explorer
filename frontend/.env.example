# Frontend configuration.
# Copy to .env.local in this directory:
#   cp .env.example .env.local

# Backend REST API origin. The client appends /api itself.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.IO endpoint. The /api/ws suffix is the gateway's namespace.
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws

# Public origin of this frontend, used when building absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt-in flag for the interactive (browser-driven) scraping UI.
NEXT_PUBLIC_ENABLE_INTERACTIVE_SCRAPING=false
